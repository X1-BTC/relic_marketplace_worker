{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "24.22.1"
  },
  "steps": {
    "install": {
      "commands": [
        "npm ci --omit=dev --ignore-scripts --no-audit --no-fund"
      ]
    },
    "build": {
      "inputs": [
        {
          "step": "install"
        }
      ],
      "commands": [
        "npm run check:marketplace-worker"
      ]
    }
  },
  "deploy": {
    "startCommand": "node --max-old-space-size=192 indexer/worker.mjs"
  }
}
